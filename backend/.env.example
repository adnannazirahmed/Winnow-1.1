# Anthropic API Key (optional)
# Without it the app runs entirely on the deterministic rule engine.
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server configuration
PORT=5000
HOST=127.0.0.1
# NEVER set FLASK_DEBUG=1 on a reachable host: the Werkzeug debugger allows RCE.
FLASK_DEBUG=0

# AI cost / latency controls
MAX_AI_REMEDIATIONS=5
ANTHROPIC_TIMEOUT_SECONDS=30
REMEDIATOR_MODEL=claude-3-haiku-20240307

# Request limits
MAX_CONFIG_BYTES=1048576

# Cross-origin access. Leave unset when Flask serves the frontend (default).
# CORS_ORIGINS=https://dashboard.example.com

# AWS Configuration (optional - for iam-vulnerable integration)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# IAM Vulnerable Configuration
IAM_VULNERABLE_ACCOUNT_ID=123456789012
IAM_VULNERABLE_ROLE_ARN=arn:aws:iam::123456789012:role/IamVulnerableRole
