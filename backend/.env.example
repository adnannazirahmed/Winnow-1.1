# ── AI provider (optional) ─────────────────────────────────────────────
# Without a provider key the app runs entirely on the deterministic engine
# (graph escalation + rule scan). Choose anthropic, openai, deepseek, or ollama.
AI_PROVIDER=anthropic
AI_MODEL=claude-3-haiku-20240307
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Ollama runs locally by default. OLLAMA_API_KEY is optional for proxied Ollama.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────
PORT=5000
HOST=127.0.0.1
# NEVER set FLASK_DEBUG=1 on a server people can reach. Debug mode turns any
# error page into a Python shell — anyone who can trigger an error runs code
# on the host.
FLASK_DEBUG=0

# ── AI cost / latency controls ─────────────────────────────────────────
MAX_AI_REMEDIATIONS=5
ANTHROPIC_TIMEOUT_SECONDS=30
REMEDIATOR_MODEL=claude-3-haiku-20240307
# AI_TIMEOUT_SECONDS=30
# AI_VALIDATION_TIMEOUT_SECONDS=15

# ── Request limits ─────────────────────────────────────────────────────
MAX_CONFIG_BYTES=1048576

# ── Cross-origin (leave unset when Flask serves the frontend) ──────────
# CORS_ORIGINS=https://dashboard.example.com

# ── Live AWS account scan (optional — "Scan AWS Account" button) ────────
# Read-only. The backend makes exactly two calls, both non-mutating:
#   iam:GetAccountAuthorizationDetails   sts:GetCallerIdentity
# Minimal policy for the credentials you use:
#   { "Effect": "Allow",
#     "Action": ["iam:GetAccountAuthorizationDetails", "sts:GetCallerIdentity"],
#     "Resource": "*" }
# Credentials come from the standard boto3 chain. Pick ONE:
#   AWS_PROFILE=my-profile
# or:
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_SESSION_TOKEN=...
AWS_DEFAULT_REGION=us-east-1
# Optional role name deployed in member accounts for organization-wide inventory.
# AWS_ORGANIZATION_ROLE_NAME=WinnowAuditRole
# MAX_ORGANIZATION_ACCOUNTS=100

# The Settings screen accepts secrets only from localhost by default. Set this
# only when the app is protected by an authenticated remote deployment.
# ALLOW_REMOTE_SETTINGS=1
